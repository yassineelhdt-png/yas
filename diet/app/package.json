{
  "name": "mon-suivi",
  "private": true,
  "version": "1.0.0",
  "description": "Mon suivi — compléments, sommeil, check-ins, symptômes, repas et macros. Android (APK) et Windows.",
  "author": "Mon suivi",
  "homepage": "https://github.com/yassineelhdt-png/yas",
  "main": "electron/main.cjs",
  "scripts": {
    "www": "node scripts/build-www.mjs",
    "icons": "node scripts/make-icons.mjs",
    "android:sync": "npm run www && cap sync android",
    "android:apk": "npm run android:sync && cd android && ./gradlew assembleRelease",
    "desktop": "npm run www && electron .",
    "desktop:win": "npm run www && electron-builder --win --publish never"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/share": "^8.0.2",
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource-variable/unbounded": "^5.3.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "sharp": "^0.35.4"
  },
  "build": {
    "appId": "com.yas.monsuivi",
    "productName": "Mon suivi",
    "copyright": "Mon suivi",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "www/**/*",
      "electron/**/*",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "shortcutName": "Mon suivi",
      "artifactName": "Mon-suivi-Installation.${ext}"
    },
    "portable": {
      "artifactName": "Mon-suivi-Portable.${ext}"
    }
  },
  "dependencies": {
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/local-notifications": "^8.3.1"
  }
}
